{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sufi-store-front-code",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-10-19",
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  }
}